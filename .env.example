# Bot identity and command configuration
BOT_NAME=IBK Nexus MD
PREFIX=.
OWNER_NUMBERS=2348012345678
PAIRING_NUMBER=

# Persistent local paths. Keep both directories on a persistent disk/volume.
AUTH_DIR=./auth
DATABASE_PATH=./data/nexus.sqlite

# Runtime and safety
PORT=3000
LOG_LEVEL=info
AUTO_READ=false
FLOOD_LIMIT=6
FLOOD_WINDOW_SECONDS=8
COMMAND_COOLDOWN_SECONDS=2
WARN_LIMIT=3
MAX_REMINDER_HOURS=168

# Optional OpenAI compatible chat completion API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MAX_TOKENS=700
AI_MEMORY_TURNS=8

# Health metrics endpoint (optional; use a long random value)
HEALTH_TOKEN=
